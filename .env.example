# Database (Backend)
DATABASE_URL="postgresql://user:password@localhost:5432/study_planner?schema=public"

# Server (Backend)
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
# Backend API URL - where Express server is running
VITE_API_URL=http://localhost:3001/api

# Enable backend sync (set to 'true' to use backend, 'false' for localStorage only)
VITE_ENABLE_BACKEND_SYNC=true

# Supabase (optional - for production deployment)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
