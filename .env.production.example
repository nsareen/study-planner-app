# Study Planner V2 - Production Environment Variables (Frontend)
# Copy this file to .env.production and fill in actual values
# Last Updated: 2025-12-30

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Railway backend URL (get this after Railway deployment)
# Format: https://study-planner-api.railway.app
# DO NOT include trailing slash
VITE_API_URL=https://your-backend-url.railway.app

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Supabase project URL (from Supabase dashboard → Project Settings → API)
# Format: https://abc123xyz.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (from Supabase dashboard → Project Settings → API)
# This is safe to expose in client-side code (it's the "anon" key, not service_role)
# Format: Long JWT token starting with eyJhbGc...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable cloud synchronization (true/false)
# Set to "true" to enable backend sync, "false" for localStorage-only
VITE_ENABLE_CLOUD_SYNC=true

# Enable analytics tracking (true/false)
# Set to "false" for MVP, enable later when analytics service is added
VITE_ENABLE_ANALYTICS=false

# Enable debug mode (true/false)
# Set to "false" in production, "true" for debugging
VITE_DEBUG_MODE=false

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================
# Google Analytics ID (if using GA)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN (if using Sentry for error tracking)
# VITE_SENTRY_DSN=https://abc123@o123456.ingest.sentry.io/123456

# =============================================================================
# DEPLOYMENT INFORMATION
# =============================================================================
# These are set automatically by Vercel, but can be overridden
# VITE_VERCEL_ENV=production
# VITE_VERCEL_URL=study-planner-v2.vercel.app
# VITE_VERCEL_GIT_COMMIT_SHA=abc123def456

# =============================================================================
# NOTES
# =============================================================================
# 1. All variables MUST start with VITE_ to be exposed to the client
# 2. Never commit this file with actual values (use .env.production.example)
# 3. Set these variables in Vercel dashboard under Project Settings → Environment Variables
# 4. Environment: Production (not Preview or Development)
# 5. After changing variables, trigger a new deployment (variables need rebuild)
# 6. Test in preview deployment first: vercel --env preview
